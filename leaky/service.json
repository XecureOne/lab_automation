{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ECS Services with security group isolation",

  "Parameters": {
    "ClusterArn": {
      "Type": "String"
    },
    "AppTaskDefinitionArn": {
      "Type": "String"
    }
  },

  "Resources": {
    "ContainerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Container task",
        "VpcId": "vpc-048641cb6ee426d64",
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [
          { "IpProtocol": "-1", "CidrIp": "0.0.0.0/0" }
        ]
      }
    },

    "AppService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": { "Ref": "ClusterArn" },
        "LaunchType": "EC2",
        "DesiredCount": 1,
        "TaskDefinition": { "Ref": "AppTaskDefinitionArn" },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["subnet-0f1e9833f5bad85a1","subnet-0ab2cc904a1af47d2","subnet-0dc03779a49bb11fc"],
            "SecurityGroups": [{ "Fn::GetAtt": ["ContainerSecurityGroup", "GroupId"] }],
            "AssignPublicIp": "DISABLED"
          }
        }
      }
    }

  },
  "Outputs": {
    "ContainerSecurityGroupId": {
      "Value": { "Ref": "ContainerSecurityGroup" },
      "Export": { "Name": "ContainerSecurityGroupId" }
    },
    "AppServiceArn": {
      "Value": { "Ref": "AppService" },
      "Export": { "Name": "AppServiceArn" }
    }
  }
}