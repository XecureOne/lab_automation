{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Two-container ECS stack with EC2 launch type, awsvpc mode, security groups on services",

  "Parameters": {
    "ECSClusterName": {"Type": "String", "Default": ""},
    "ECSAutoScalingGroupName": {"Type": "String", "Default": ""}
  },

  "Resources": {
    "EC2SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "EC2 host - allow all traffic within VPC for awsvpc ENI attachment",
        "VpcId": "vpc-0cbebf51c551f38ce",
        "SecurityGroupIngress": [
          { "IpProtocol": "-1", "CidrIp": "10.0.0.0/16" }
        ],
        "SecurityGroupEgress": [
          { "IpProtocol": "-1", "CidrIp": "0.0.0.0/0" }
        ]
      }
    },

    "ECSInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": ["ecsInstanceRole"] }
    },

    "ECSCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": { "ClusterName": { "Ref": "ECSClusterName"} }
    },

    "ECSLaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": "ecs-ec2-launch-template",
        "LaunchTemplateData": {
          "ImageId": "ami-057c5aaa689beed99",
          "InstanceType": "t2.micro",
          "KeyName": "mumbai",
          "IamInstanceProfile": {
            "Name": { "Ref": "ECSInstanceProfile" }
          },
          "UserData": {
            "Fn::Base64": {
              "Fn::Sub": "#!/bin/bash\necho ECS_CLUSTER=${ECSCluster} >> /etc/ecs/ecs.config\necho ECS_ENABLE_TASK_ENI=true >> /etc/ecs/ecs.config"
            }
          },
          "TagSpecifications": [
            {
              "ResourceType": "instance",
              "Tags": [
                { "Key": "Name", "Value": "ecs-ec2-instance" }
              ]
            }
          ]
        }
      }
    },

    "ECSAutoScalingGroup": {
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "Properties": {
        "AutoScalingGroupName": { "Ref": "ECSAutoScalingGroupName"},
        "MinSize": "0",
        "MaxSize": "2",
        "DesiredCapacity": "0",
        "LaunchTemplate": {
          "LaunchTemplateId": { "Ref": "ECSLaunchTemplate" },
          "Version": { "Fn::GetAtt": ["ECSLaunchTemplate", "LatestVersionNumber"] }
        },
        "VPCZoneIdentifier": ["subnet-07466d983628bb51b"],
        "Tags": [{ "Key": "AmazonECSManaged", "Value": "true", "PropagateAtLaunch": true }]
      }
    },

    "ECSCapacityProvider": {
      "Type": "AWS::ECS::CapacityProvider",
      "DependsOn": ["ECSAutoScalingGroup"],
      "Properties": {
        "Name": "ec2-capacity-provider",
        "AutoScalingGroupProvider": {
          "AutoScalingGroupArn": { "Ref": "ECSAutoScalingGroup" },
          "ManagedScaling": { "Status": "ENABLED", "TargetCapacity": 100 },
          "ManagedTerminationProtection": "DISABLED"
        }
      }
    },

    "ClusterCapacityProviderAssociation": {
      "Type": "AWS::ECS::ClusterCapacityProviderAssociations",
      "DependsOn": ["ECSCapacityProvider", "ECSCluster"],
      "Properties": {
        "Cluster": { "Ref": "ECSCluster" },
        "CapacityProviders": ["ec2-capacity-provider"],
        "DefaultCapacityProviderStrategy": [{ "CapacityProvider": "ec2-capacity-provider", "Weight": 1 }]
      }
    }

  },

  "Outputs": {
    "ECSClusterArn": {
      "Value": { "Fn::GetAtt": ["ECSCluster", "Arn"] },
      "Export": { "Name": "ECSClusterArn" }
    },
    "ECSAutoScalingGroupArn": {
      "Value": { "Ref": "ECSAutoScalingGroup" },
      "Export": { "Name": "ECSAutoScalingGroupArn" }
    }
  }
}