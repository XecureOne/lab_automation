{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECSClusterAndService",
      "Effect": "Allow",
      "Action": [
        "ecs:*",
        "application-autoscaling:*",
        "elasticloadbalancing:*",
        "ecr:*",
        "ec2:*",
        "cloudwatch:*",
        "logs:*"
      ],
      "Resource": "*"
    }
  ]
}