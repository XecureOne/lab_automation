{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullSQSAccess",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchReadOnlyForSQSMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DescribeAlarmsForMetric"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyUnrelatedServices",
      "Effect": "Deny",
      "Action": [
        "ec2:*", "s3:*", "iam:*", "lambda:*", "sns:*", "rds:*",
        "dynamodb:*", "ecs:*", "ecr:*", "cloudformation:*",
        "secretsmanager:*", "kms:*", "route53:*", "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
