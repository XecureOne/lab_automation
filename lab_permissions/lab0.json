{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowOnlyOnCertain",
            "Effect": "Allow",
            "Action": [
                "iam:ListRoles",
                "iam:ListUsers",
                "iam:ListGroups",
                "iam:*Role*",
                "iam:*User*",
                "iam:*Group*",
                "iam:*Policy*",
                "iam:*Policies",
                "iam:*LoginProfile",
                "iam:*InstanceProfile*",
                "iam:ListAccessKeys",
                "iam:ListSigningCertificates",
                "iam:ListSSHPublicKeys",
                "iam:ListServiceSpecificCredentials",
                "iam:ListMFADevices"
            ],
            "Resource": "*"
        }
    ]
}
