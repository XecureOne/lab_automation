{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAndManageAppDBRole",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:ListRoles",
        "iam:*Role*",
        "iam:*Role"
      ],
      "Resource": "arn:aws:iam::*:role/*"
    },
    {
        "Sid": "AllowAttachAndDetachCapabilities",
        "Effect": "Allow",
        "Action": [
            "iam:AttachRolePolicy",
            "iam:DetachRolePolicy"
        ],
        "Resource": "*"
    },
        {
            "Sid": "DenyAllAWSManagedPoliciesExceptWhitelist",
            "Effect": "Deny",
            "Action": [
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy"
            ],
            "Resource": "*",
            "Condition": {
                "ArnLike": {
                    "iam:PolicyARN": "arn:aws:iam::aws:policy/*"
                },
                "ArnNotEquals": {
                    "iam:PolicyARN": [
                        "arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess",
                        "arn:aws:iam::aws:policy/AmazonEC2ReadOnlyAccess"
                    ]
                }
            }
        },
    {
      "Sid": "CreateInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:ListInstanceProfiles",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::*:instance-profile/*"
    },
    {
      "Sid": "PassRoleScopedToAppDBRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
        "Sid": "EC2Role",
        "Action": "ec2:*",
        "Effect": "Allow",
        "Resource": "*"
    },
    {
      "Sid": "EC2AttachRole",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateIamInstanceProfile",
        "ec2:DescribeIamInstanceProfileAssociations",
        "ec2:DescribeInstances",
        "ec2:ReplaceIamInstanceProfileAssociation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyVerification",
      "Effect": "Allow",
      "Action": [
        "iam:ListPolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenySelfModification",
      "Effect": "Deny",
      "Action": [
        "iam:*"
      ],
      "Resource": "arn:aws:iam::*:role/OrganizationAccountAccessRole"
    }
  ]
}