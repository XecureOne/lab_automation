{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FullS3Access",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": "*"
    },
    {
      "Sid": "DenyUnrelatedServices",
      "Effect": "Deny",
      "Action": [
        "ec2:*", "iam:*", "lambda:*", "cloudformation:*", "rds:*",
        "ecs:*", "ecr:*", "route53:*", "cloudwatch:*", "sns:*",
        "sqs:*", "dynamodb:*", "elasticloadbalancing:*", "autoscaling:*",
        "organizations:*"
      ],
      "Resource": "*"
    }
  ]
}
