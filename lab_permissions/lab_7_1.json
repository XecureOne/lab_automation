{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ElasticBeanstalkFullManagement",
      "Effect": "Allow",
      "Action": [
        "elasticbeanstalk:*",
        "sns:*",
        "s3:*",
        "ec2:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "cloudwatch:*",
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "*"
    }
  ]
}